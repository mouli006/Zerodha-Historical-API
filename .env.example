# Reference only: the app creates and updates .env itself when you sign in.
# Never commit your real .env.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_DATA_DIR=
FLASK_SECRET_KEY=
# Dhan (optional, sign-in only for now; written by the Dhan tab of the sign-in page)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_EXPIRY=
# Weekly expiry weekday (MON..FRI) per underlying, used only to estimate the earliest F&O date before any history
# exists; blank uses NIFTY TUE, SENSEX THU (WEEKLY_EXPIRY_WEEKDAY is the older NIFTY key)
WEEKLY_EXPIRY_WEEKDAY=TUE
WEEKLY_EXPIRY_WEEKDAY_SENSEX=
# Keep F&O contracts whose Kite candles all have volume 0 (ON/OFF); blank uses the default in config.py
KEEP_ZERO_VOLUME=
# Download only the F&O contracts in the day's NSE/BSE bhavcopy, Kite and Dhan (ON/OFF); blank uses the default in config.py
TRIM_TO_BHAV=
# F&O folders (optional): raw base folder per broker (the F&O cards' and CLIs' default; downloads go to its
# with_zero_volume / without_zero_volume store by the keep zero-volume setting; blank = KITE_DATA_DIR, no stores)
# and the base of the backtest stores built by fno_store.py publish
FNO_RAW_KITE=
FNO_RAW_DHAN=
FNO_BACKTEST_DIR=
# After a keep zero-volume ON day in the with store, also save its without-zero-volume copy (ON/OFF); blank uses config.py (ON)
DERIVE_WITHOUT_ZERO_VOLUME=
