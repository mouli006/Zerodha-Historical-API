# Reference only: the app creates and updates .env itself when you sign in.
# Never commit your real .env.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_DATA_DIR=
FLASK_SECRET_KEY=
# NIFTY weekly expiry weekday (MON..FRI), used only to estimate the earliest F&O date before any history exists
WEEKLY_EXPIRY_WEEKDAY=TUE
# Keep F&O contracts whose Kite candles all have volume 0 (ON/OFF); blank uses the default in config.py
KEEP_ZERO_VOLUME=
